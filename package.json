{
  "name": "qrcodefyi",
  "version": "0.1.0",
  "description": "TypeScript API client for QRCodeFYI -- QR code types, versions, encoding modes, error correction, and standards. Zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "qr-code",
    "qr",
    "encoding",
    "error-correction",
    "api-client",
    "qrcodefyi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fyipedia/qrcodefyi-js"
  },
  "homepage": "https://qrcodefyi.com",
  "license": "MIT",
  "author": "FYIPedia",
  "devDependencies": {
    "tsup": "^8.0",
    "typescript": "^5.7",
    "vitest": "^3.0"
  }
}
